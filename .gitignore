# Claude Code orchestration temp files (generated during workflow)
.claude/temp/
!.claude/temp/.gitkeep

# Claude research outputs
.claude/research/

# Codex workflow artifacts
codex/temp/

# Local settings
.claude/settings.local.json

# Reflections are machine-local (live in ~/.claude/reflections/), never in the repo
.claude/reflections/

# Antigravity CLI local project symlinks (per-machine, points into ~/.gemini/config)
.antigravitycli/

# Python bytecode (hook + test helpers)
__pycache__/
*.pyc

# Codex-side reflections are machine-local too (live in ~/.codex/reflections/), never in the repo
.codex/reflections/

# global/: AGENTS.md + README.md are public; inbox, archive, registrations stay private
/global/*
!/global/AGENTS.md
!/global/README.md

# Downloaded third-party sources; pins and selection policy live in dependencies.json
/vendor/
